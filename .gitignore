# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ── Node / Next.js ────────────────────────────────────────────
node_modules/
my-portfolio/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
/.next/
/out/
/build
/coverage
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.tsbuildinfo
next-env.d.ts

# ── Python ────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
*.pdb
.venv/
venv/
backend/venv/
*.egg-info/
dist/
*.egg

# ── Environment / secrets ─────────────────────────────────────
.env
.env.*
!.env.example

# ── Whisper model weights (large binary files, never commit) ──
backend/whisper_bin/Release/models/*.bin
backend/whisper_bin/Release/models/*.gguf

# ── Whisper compiled binaries (OS-specific, rebuild locally) ──
backend/whisper_bin/Release/*.exe
backend/whisper_bin/Release/*.dll
backend/whisper_bin/Release/*.so
backend/whisper_bin/

# ── Audio / uploads (user data, not source code) ─────────────
backend/audio_files/
backend/uploads/
*.webm
*.wav
*.mp3
*.ogg
*.m4a
*.aac

# ── Logs ──────────────────────────────────────────────────────
backend/logs/
*.log

# ── VS Code history ───────────────────────────────────────────
.history/

# ── Misc ──────────────────────────────────────────────────────
.DS_Store
*.pem
.vercel
Thumbs.db
